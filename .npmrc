# Build-time dependencies with known vulns that don't affect runtime:
# - html-minifier (via vite-plugin-prerender) — no fix available, build-only
# - node-cron uuid dependency — internal scheduling lib, negligible runtime risk
# - esbuild (via Vite) — dev server only, not exposed in production
audit-level=moderate

# @perfood/capacitor-healthkit pins to Capacitor 4 peer; rest of project is on
# Capacitor 8. Plugin works fine across major versions for our usage; this lets
# npm install proceed on stricter resolvers (Vercel uses npm 10+).
legacy-peer-deps=true
