<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep linking: bionhealth.co.za opens in the app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bionhealth.co.za" />
                <data android:scheme="https" android:host="www.bionhealth.co.za" />
            </intent-filter>

            <!-- Custom URL scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bion" />
            </intent-filter>

            <!-- Health Connect permission rationale intent -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <meta-data
                android:name="health_permissions"
                android:resource="@array/health_permissions" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ runtime push notification permission. Without this,
         system push notifications won't display on Android 13 (API 33) and up.
         App must call requestPermission() at runtime as well. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- QA audit M-4 (2026-04-28): image picking on Android 13+ requires
         the granular READ_MEDIA_IMAGES permission. Without it, the
         HTML file input + Capacitor camera plugin silently fail when
         the user tries to attach a profile photo, food log image, or
         medical aid card scan. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Pre-API-33 fallback (Android 12 and below). Scoped to maxSdkVersion=32
         because READ_MEDIA_IMAGES supersedes it on API 33+ — declaring both
         without the cap triggers Play pre-launch warnings about overreach. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Health Connect permissions — trimmed 2026-04-26 to match actual reads in
      src/hooks/useNativeHealth.ts (Steps, HeartRate, Weight). Adding more
      permissions here without a corresponding read/write fn triggers Play
      Store pre-launch warnings about excess permissions.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Declare Health Connect activity for permission rationale -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
